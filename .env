# FlutterCamp runs fully on a built-in mock backend — no real API is contacted.
NEXT_PUBLIC_USE_MOCKS=true

# Kept only so the axios baseURL is well-formed; the mock adapter intercepts
# every request before any network call is made.
NEXT_PUBLIC_BASE_URL=https://dash.fluttercamp.com/api/development
NEXT_PUBLIC_X_API_KEY=mock

# Empty so getImageUrl() leaves relative /public paths relative and passes the
# absolute mock image URLs (picsum / dicebear) through untouched.
NEXT_PUBLIC_ASSETS_BASE_URL=
NEXT_PUBLIC_YOUTUBE_API_KEY=
